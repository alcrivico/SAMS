<Window
    x:Class="SAMS.UI.Views.ReporteCajaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SAMS.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SAMS.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SAMS - Ventas"
    Width="400"
    Height="600"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Border Background="{StaticResource SolidColorBrush_LavenderWeb}" CornerRadius="30">
            <Border
                Margin="30"
                Background="{StaticResource SolidColorBrush_GhostWhite}"
                CornerRadius="20">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.1*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0.1*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font_Nunito}"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="Detalle de Monedero" />

                    <Grid Grid.Row="1" Margin="20">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <components:TextBoxControl
                                x:Name="campoNoCaja"
                                Grid.Column="0"
                                Width="103"
                                FieldName="No. de Caja"
                                IsReadOnly="True"
                                TextFontSize="12" />

                            <components:TextBoxControl
                                x:Name="campoFechaCierre"
                                Grid.Column="1"
                                Width="138"
                                FieldName="Fecha de Cierre"
                                IsReadOnly="True"
                                TextFontSize="12" />

                        </Grid>

                        <components:TextBoxControl
                            x:Name="campoNoVentas"
                            Grid.Row="1"
                            Width="114"
                            FieldName="No. de Ventas"
                            IsReadOnly="True"
                            TextFontSize="12" />

                        <components:TextBoxControl
                            x:Name="campoTotalEfectivo"
                            Grid.Row="2"
                            Width="160"
                            FieldName="Total en Efectivo $"
                            IsReadOnly="True"
                            TextFontSize="12" />

                        <components:TextBoxControl
                            x:Name="campoTotalTarjeta"
                            Grid.Row="3"
                            Width="160"
                            FieldName="Total con Tarjeta $"
                            IsReadOnly="True"
                            MaxLengthTextBox="10"
                            TextFontSize="12" />

                        <components:TextBoxControl
                            x:Name="campoTotalMonedero"
                            Grid.Row="4"
                            Width="160"
                            FieldName="Total con Monedero $"
                            IsReadOnly="True"
                            TextFontSize="12" />

                        <components:TextBoxControl
                            x:Name="campoTotal"
                            Grid.Row="5"
                            Width="160"
                            FieldName="Total $"
                            IsReadOnly="True"
                            TextFontSize="12" />

                        <components:TextBoxControl
                            x:Name="campoDiferencias"
                            Grid.Row="6"
                            Width="160"
                            FieldName="Diferencias Detectadas"
                            IsReadOnly="True"
                            MaxLengthTextBox="10"
                            TextFontSize="12" />

                        <components:TextBoxControl
                            x:Name="campoResponsable"
                            Grid.Row="7"
                            Width="160"
                            FieldName="Responsable de Caja"
                            IsReadOnly="True"
                            TextFontSize="12" />

                    </Grid>

                    <components:ButtonControl
                        x:Name="botonSalir"
                        Grid.Row="2"
                        Margin="0,0,0,10"
                        ButtonBackgroundColor="{StaticResource SolidColorBrush_PantoneOrange}"
                        ButtonControlClick="botonSalir_ButtonControlClick"
                        ButtonForegroundColor="{StaticResource SolidColorBrush_White}"
                        ButtonHeight="26"
                        ButtonWidth="150"
                        FontSize="18"
                        Text="Salir" />

                </Grid>

            </Border>

        </Border>

    </Grid>

</Window>
