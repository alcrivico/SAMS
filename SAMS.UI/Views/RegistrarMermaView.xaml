<Window
    x:Class="SAMS.UI.Views.RegistrarMermaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:SAMS.UI.VisualComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SAMS.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Registrar proveedor"
    Width="600"
    Height="600"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Border Background="{StaticResource SolidColorBrush_LavenderWeb}" CornerRadius="20" Margin="0,0,0,61">
            <Border
                Margin="30"
                Background="{StaticResource SolidColorBrush_AntiFlashWhite}"
                CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.1*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0.2*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font_Nunito}"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="Registrar merma" />

                    <Grid Grid.Row="1" Margin="35,0,35,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <components:ComboBoxControl
                                x:Name="comboProducto"
                                Margin="50,0,50,0"
                                FieldName="Productos en inventario:"                               
                                SelectedItemChanged="comboProducto_SelectedItemChanged" Height="49" VerticalAlignment="Center" 
                            />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="0.5*" />
                            </Grid.ColumnDefinitions>

                            <components:TextBoxControl
                                x:Name="campoCantidadBodega"
                                Grid.Column="0"
                                Width="150"                               
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                FieldName="En bodega" Height="46" />

                            <components:TextBoxControl
                                x:Name="campoCantidadExhibicion"
                                Grid.Column="1"
                                Width="150"                               
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                FieldName="En exhibición" Height="46" />

                        </Grid>

                        <Grid Grid.Row="2">
                            <components:ComboBoxControl
                                x:Name="comboArea"
                                Margin="50,0,50,0"
                                FieldName="Ubicacion de los productos:"
                                Height="74" VerticalAlignment="Center"
                                SelectedItemChanged="comboArea_SelectedItemChanged"
                                />
                            
                        </Grid>

                        <Grid Grid.Row="3">

                            <components:TextBoxControl
                                x:Name="campoCantidad"
                                Width="220"                               
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                PreviewTextInput="campoCantidad_PreviewTextInput"
                                FieldName="Cantidad" Height="46" 
                                TextBoxControlTextChanged="campoCantidad_TextBoxControlTextChanged"/>

                        </Grid>

                        <Grid Grid.Row="4">

                            <components:TextBoxControl
                                x:Name="campoDescripcion"
                                Width="420"                               
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FieldName="Descripción" Height="46" 
                                TextBoxControlTextChanged="campoDescripcion_TextBoxControlTextChanged"/>

                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Margin="10,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                        </Grid.ColumnDefinitions>

                        <components:ButtonControl
                            x:Name="botonRegistrar"
                            Grid.Column="0"
                            Margin="0,0,0,10"
                            IsButtonEnabled="False"
                            ButtonBackgroundColor="{StaticResource SolidColorBrush_DodgerBlue}"
                            ButtonControlClick="botonRegistrar_ButtonControlClick"
                            ButtonForegroundColor="{StaticResource SolidColorBrush_White}"
                            ButtonWidth="160"
                            FontSize="18"
                            Text="Registrar" />
                        <components:ButtonControl
                            x:Name="botonCancelar"
                            Grid.Column="1"
                            Margin="0,0,0,10"
                            ButtonBackgroundColor="{StaticResource SolidColorBrush_PantoneOrange}"
                            ButtonControlClick="botonCancelar_ButtonControlClick"
                            ButtonForegroundColor="{StaticResource SolidColorBrush_White}"
                            ButtonWidth="160"
                            FontSize="18"
                            Text="Cancelar" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>


